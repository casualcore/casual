ngx_module_name=ngx_http_casual_module
ngx_module_type=HTTP
ngx_module_srcs="$ngx_addon_dir/$ngx_module_name.c"
ngx_module_incs="$ngx_addon_dir $CMAKE_SOURCE_DIR/middleware/http/include"
ngx_module_libs="-L$CMAKE_BINARY_DIR/middleware/http/bin -lcasual-http-inbound-common" 

platform=`uname`

echo "Building nginx on platform = $platform"

if [[ "$platform" != "Darwin" ]]; then
    ngx_module_libs="$ngx_module_libs \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/buffer/bin \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/xatmi/bin \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/common/bin \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/server/bin \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/service/bin \
        -Wl,-rpath-link=$CMAKE_BINARY_DIR/middleware/transaction/bin"
else
    ngx_module_libs="$ngx_module_libs -Wl,-rpath,$CASUAL_HOME/lib"
fi

. auto/module

ngx_addon_name=$ngx_module_name

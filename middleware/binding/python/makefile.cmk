import casual.make.api as make
import casual.middleware.make.api as dsl

install_python_server = [
    "src/casual/server/__init__.py",
    "src/casual/server/api.py",
    "src/casual/server/buffer.py",
    "src/casual/server/exception.py",
    "src/casual/server/log.py",
]

install_python_xatmi = ["src/casual/xatmi/__init__.py", "src/casual/xatmi/xatmi.py"]


make.Install("example/bin/python-example-server.py", dsl.paths().install + "/example/bin")
make.Install("example/bin/python-example-client.py", dsl.paths().install + "/example/bin")

make.Install("src/casual/__init__.py", dsl.paths().install + "/python/casual")
make.Install(install_python_server, dsl.paths().install + "/python/casual/server")
make.Install(install_python_xatmi, dsl.paths().install + "/python/casual/xatmi")
